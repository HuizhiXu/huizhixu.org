{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- $index = $index | append (dict "title" .Title "tags" .Params.tags "date" .Lastmod
    "summary" (.Summary | plainify | htmlUnescape | truncate 180)
    "contents" .Plain "permalink" .RelPermalink) -}}
{{- end -}}
{{- $index | jsonify -}}
